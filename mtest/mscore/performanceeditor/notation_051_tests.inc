void TestPerformanceEditor::freeSlurRoutedGeometry()
      {
      using FreeSlur::CurvePoint;QVector<CurvePoint> line{{0,{0,0},{100,0},true},{1,{100,0},{100,0},true}};
      const QVector<QRectF> obstacles{{40,-4,20,8}};
      auto below=FreeSlur::avoid(line,obstacles,true,10,{{0,1,1}},false);QCOMPARE(below.collisions,0);QVERIFY(FreeSlur::curvePosition(below.points,.5).y()>4);
      auto above=FreeSlur::avoid(line,obstacles,false,10,{{0,1,-1}},false);QCOMPARE(above.collisions,0);QVERIFY(FreeSlur::curvePosition(above.points,.5).y()<-4);
      line.insert(1,{.5,{50,0},{100,0},true});
      const QVector<QRectF> pair{{20,-3,10,6},{70,-3,10,6}};const QVector<FreeSlur::Route> routes{{0,.5,-1},{.5,1,1}};
      auto split=FreeSlur::avoid(line,pair,true,10,routes,false);QCOMPARE(split.collisions,0);
      QVERIFY(FreeSlur::curvePosition(split.points,.25).y()<-3);QVERIFY(FreeSlur::curvePosition(split.points,.75).y()>3);QCOMPARE(FreeSlur::curvePosition(split.points,.5),QPointF(50,0));
      for(const auto& point:split.points)if(point.t>1e-4&&point.t<1-1e-4){const auto left=FreeSlur::curvePoint(split.points,point.t-1e-7).d,right=FreeSlur::curvePoint(split.points,point.t+1e-7).d;QVERIFY(QLineF(left,right).length()<.01);}
      auto fixed=FreeSlur::avoid(line,obstacles,true,10,{{0,1,-1}},false);QVERIFY(fixed.collisions>0);QCOMPARE(FreeSlur::curvePosition(fixed.points,.5),QPointF(50,0));
      QElapsedTimer timer;timer.start();for(int i=0;i<200;++i){const auto again=FreeSlur::avoid(line,pair,true,10,routes,false);QCOMPARE(again.collisions,split.collisions);QCOMPARE(again.points.size(),split.points.size());}qInfo("routed slur, 200 cached layouts: %.3f ms",timer.nsecsElapsed()/1e6);
      QVector<FreeSlurNode> nodes{{.5,{}, {},false,-1,1}};auto local=FreeSlur::routing(nodes,.25,.75);QCOMPARE(local.size(),2);QCOMPARE(local[0].from,0.);QCOMPARE(local[0].until,.5);QCOMPARE(local[1].direction,1);
      nodes[0].after=-1;auto merged=FreeSlur::routing(nodes,0,1);QCOMPARE(merged.size(),1);QCOMPARE(merged[0].until,1.);
      auto saved=FreeSlur::encode(nodes);QVector<FreeSlurNode> decoded;QVERIFY(FreeSlur::decode(saved,&decoded));QCOMPARE(decoded[0].before,-1);QCOMPARE(decoded[0].after,-1);QVERIFY(!decoded[0].locked);
      QVERIFY(!FreeSlur::decode("[[0.5,0,0,0,0,true,2,0]]",&decoded));QVERIFY(!FreeSlur::decode("[[0.5,0,0,0,0,true,0.5,0]]",&decoded));
      nodes.append({.75,{}, {},true,-1,-1});QVERIFY(FreeSlur::removeNode(&nodes,0));QCOMPARE(nodes[0].before,-1);
      }
