void TestPerformanceEditor::handSymbolPlacementExamples()
      {
      const int pitches[]={60,62,64,65,67,69,71,72,74,76,77,79,81,83,84,86};const int tpc[]={14,16,18,13,15,17,19};
      QByteArray xml("<museScore version=\"3.02\"><Score><Division>480</Division><Part><Staff id=\"1\"><StaffType group=\"pitched\"><name>stdNormal</name></StaffType></Staff><Staff id=\"2\"><StaffType group=\"pitched\"><name>stdNormal</name></StaffType></Staff><trackName>Piano</trackName><Instrument id=\"piano\"><instrumentId>keyboard.piano</instrumentId><Channel/></Instrument></Part>");
      for(int staff=1;staff<=2;++staff){xml+="<Staff id=\""+QByteArray::number(staff)+"\">";for(int m=0;m<4;++m){xml+="<Measure><voice>";if(!m)xml+="<Clef><concertClefType>"+QByteArray(staff==1?"G":"F")+"</concertClefType><transposingClefType>"+QByteArray(staff==1?"G":"F")+"</transposingClefType></Clef><TimeSig><sigN>4</sigN><sigD>4</sigD></TimeSig>";for(int n=0;n<4;++n){int i=m*4+n;xml+="<Chord>";if(staff==1&&i==1)xml+="<staffMove>1</staffMove>";xml+="<durationType>quarter</durationType><Note><pitch>"+QByteArray::number(pitches[i]-(staff==2?24:0))+"</pitch><tpc>"+QByteArray::number(tpc[i%7])+"</tpc></Note>";if(staff==1&&i==0)xml+="<Note><pitch>64</pitch><tpc>18</tpc></Note><Note><pitch>67</pitch><tpc>15</tpc></Note>";xml+="</Chord>";}xml+="</voice></Measure>";}xml+="</Staff>";}xml+="</Score></museScore>";
      const auto file=_directory.filePath("hand-placement-examples.mscx");QFile outputFile(file);QVERIFY(outputFile.open(QIODevice::WriteOnly));outputFile.write(xml);outputFile.close();auto score=Ms::mscore->readScore(file);QVERIFY(score);Ms::mscore->setCurrentScoreView(Ms::mscore->appendScore(score));
      Ms::mscore->performanceEditor()->setScoreBandEnabled(false);
      const auto before=freeSlurMidi(score);QVector<Symbol*> marks;const SymId roles[]={SymId::keyboardPlayWithLH,SymId::keyboardPlayWithRH,SymId::keyboardPlayWithLHEnd,SymId::keyboardPlayWithRHEnd};int i=0;
      score->startCmd();for(auto segment=score->firstSegment(SegmentType::ChordRest);segment;segment=segment->next1(SegmentType::ChordRest))for(int track:{0,4}){auto e=segment->element(track);if(!e||!e->isChord())continue;auto note=track==0&&segment->tick().ticks()==0?toChord(e)->notes()[1]:toChord(e)->upNote();auto mark=new Symbol(score);mark->setSym(roles[i++%4]);mark->applyHandPreset();mark->setProperty(Pid::HAND_BRACKET_TEXT,true);mark->setParent(note);mark->setTrack(track);score->undoAddElement(mark);marks.append(mark);}score->endCmd();score->doLayout();QCOMPARE(marks.size(),32);
      for(auto mark:marks){auto note=toNote(mark->parent());auto chord=note->chord();const auto grips=mark->gripsPositions();const auto corner=grips[2];const double grid=chord->spatium(),unit=mark->spatium()*mark->mag(),space=(corner.y()-chord->measure()->system()->staffYpage(chord->vStaffIdx()))/grid-.5;QVERIFY(std::abs(space-std::round(space))<.001);const auto head=note->bbox().translated(note->pagePos());const auto end=grips[0];const double gap=mark->getProperty(Pid::HAND_BRACKET_H).toDouble()>0?head.left()-end.x():end.x()-head.right();QVERIFY(gap>=.27*unit);QVERIFY(gap<=1.41*unit);}
      QCOMPARE(freeSlurMidi(score),before);auto view=Ms::mscore->currentScoreView();view->adjustCanvasPosition(score->firstMeasure(),false);QTest::qWait(80);const auto output=qEnvironmentVariable("HARMONY_TEST_ARTIFACTS");if(!output.isEmpty()){view->grab().save(output+"/hand-placement-score-051.png");QVERIFY(Ms::mscore->savePdf(score,output+"/hand-placement-051.pdf"));}
      }
void TestPerformanceEditor::notationPaletteMigration()
      {
      PalettePanel tempo(PalettePanel::Type::Tempo);auto original=new TempoText(gscore);original->setXmlText("My tempo");tempo.append(original,"My entry");
      for(int i=0;i<2;++i){auto line=new TextLine(gscore,true);line->setBeginText(i?"rit.":"Kumo rit");line->setProperty(Pid::RIT_PLAY,true);tempo.append(line,"Old rit");if(!i){tempo.cell(1)->tag="kumo-rit";tempo.cell(1)->custom=true;}}
      auto custom=new TextLine(gscore,true);custom->setBeginText("poco rit.");custom->setProperty(Pid::RIT_PLAY,true);tempo.append(custom,"My rit");tempo.cell(tempo.ncells()-1)->custom=true;
      for(int i=0;i<2;++i){auto text=new TempoText(gscore);text->setXmlText("a tempo");text->setProperty(Pid::TEMPO_RESTORE_MODE,1);tempo.append(text,"Old restore");}
      appendPlayableTempoSymbols(&tempo);int rit=0,restore=0,customCount=0;TempoText normal(gscore);
      for(int i=0;i<tempo.ncells();++i){auto cell=tempo.cell(i);if(cell->custom){++customCount;QCOMPARE(cell->name,QString("My rit"));continue;}auto e=cell->element.get();if(e->isTextLine()&&toTextLine(e)->ritPlay()){++rit;QCOMPARE(cell->mag,1.);QCOMPARE(toTextLine(e)->beginText(),QString("rit."));QCOMPARE(e->getProperty(Pid::BEGIN_FONT_FACE),normal.getProperty(Pid::FONT_FACE));}if(e->isTempoText()&&toTempoText(e)->restoreMode()==1)++restore;QVERIFY(!cell->tag.startsWith("kumo-"));}QCOMPARE(rit,1);QCOMPARE(restore,1);QCOMPARE(customCount,1);QCOMPARE(tempo.cell(0)->name,QString("My entry"));
      auto restored=PalettePanel::readMimeData(tempo.mimeData());QVERIFY(restored);QCOMPARE(restored->ncells(),tempo.ncells());
      PalettePanel hands(PalettePanel::Type::Fingering);for(auto id:{SymId::keyboardPlayWithLH,SymId::keyboardPlayWithLHEnd,SymId::keyboardPlayWithRH,SymId::keyboardPlayWithRHEnd})for(int n=0;n<2;++n){auto mark=new Symbol(gscore);mark->setSym(id);if(n)mark->applyHandPreset();hands.append(mark,"Old hand");}
      auto mine=new Symbol(gscore);mine->setSym(SymId::keyboardPlayWithRH);hands.append(mine,"My hand",QString(),.9);hands.cell(hands.ncells()-1)->custom=true;completeHandBracketPalette(&hands);QCOMPARE(hands.ncells(),5);int own=0;
      for(int i=0;i<hands.ncells();++i){auto cell=hands.cell(i);if(cell->custom){QCOMPARE(cell->name,QString("My hand"));QCOMPARE(cell->mag,.9);QVERIFY(!toSymbol(cell->element.get())->handBracket());}else{++own;QCOMPARE(cell->mag,.55);QVERIFY(toSymbol(cell->element.get())->handBracket());}}QCOMPARE(own,4);
      auto reloaded=PalettePanel::readMimeData(hands.mimeData());QVERIFY(reloaded);QCOMPARE(reloaded->ncells(),5);
      }
