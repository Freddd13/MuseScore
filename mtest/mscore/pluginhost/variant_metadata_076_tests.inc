// Exercise the same public plugin and metadata path used by the installed app.
void TestPluginHost::metadataSkipsSupportComponents()
{
    QVERIFY(QDir(_settings.path()).mkpath("HarmonyAssistant"));
    const auto path = _settings.filePath("HarmonyAssistant/support-076.qml");QFile file(path);
    QVERIFY(file.open(QIODevice::WriteOnly));
    file.write("import QtQuick 2.9\nItem { Component.onCompleted: probe.objectName = 'created' }\n");
    file.close();
    QmlPluginEngine engine;QObject probe;probe.setObjectName("untouched");
    engine.rootContext()->setContextProperty("probe",&probe);
    PluginDescription description;description.path=path;
    QVERIFY(!collectPluginMetaInformation(&description,&engine));
    QCOMPARE(probe.objectName(),QString("untouched"));
    const auto actual=_settings.filePath("HarmonyAssistant/ActualPlugin.qml");QFile plugin(actual);
    QVERIFY(plugin.open(QIODevice::WriteOnly));
    plugin.write("/* Item { example only } */\nimport MuseScore 3.0 as API\nAPI.MuseScore { version: '9.0'; description: 'metadata test' }\n");plugin.close();
    description.path=actual;QVERIFY(collectPluginMetaInformation(&description,&engine));
    QCOMPARE(description.version,QString("9.0"));
}

void TestPluginHost::legacyVariantsSaveBeforeSwitch()
{
    auto main=Ms::mscore;
    auto source=main->readScore(QString(TESTROOT)+"/mtest/mscore/scoreobserver/piano.mscx");QVERIFY(source);
    main->setCurrentScoreView(main->appendScore(source));main->resize(1200,900);main->show();
    const auto sourceState=source->state();const auto sourceUndo=source->undoStack()->getCurIdx();
    main->pluginTriggered(QString(TESTROOT)+"/share/plugins/ArrangementVariants/ArrangementVariants_MS3.qml");
    QmlPlugin* panel=nullptr;
    for(auto window:QGuiApplication::allWindows())if(auto view=qobject_cast<QQuickView*>(window))
        if(auto root=qobject_cast<QmlPlugin*>(view->rootObject()))
            if(root->menuPath()=="Plugins.Arrangement Variants")panel=root;
    QVERIFY(panel);panel->setProperty("workspace",QUrl::fromLocalFile(_settings.filePath("variants-076.json")).toString());
    const auto invoke=[&panel](const char* method){return QMetaObject::invokeMethod(panel,method);};
    const auto groups=[&panel]{return panel->property("groups").value<QJSValue>().toVariant().toList();};
    QVERIFY(invoke("newGroup"));
    QTRY_VERIFY_WITH_TIMEOUT(!panel->property("busy").toBool(),6000);
    QTRY_VERIFY(main->currentScore()!=source);
    const auto writing=main->currentScore();QVERIFY(!writing->masterScore()->readOnly());
    QVERIFY(writing->masterScore()->property("kumoWorkflowOwned").toBool());
    QVERIFY(!writing->masterScore()->created());
    auto note=toChord(writing->tick2segment(Fraction::fromTicks(480),false,SegmentType::ChordRest)->element(0))->notes().front();
    const auto pitch=note->pitch();
    QCOMPARE(pitch,59);
    writing->startCmd();writing->undoChangePitch(note,pitch+1,14,14);writing->endCmd();
    QCOMPARE(note->pitch(),pitch+1);
    QVERIFY(QMetaObject::invokeMethod(panel,"switchTo",Q_ARG(QVariant,0),Q_ARG(QVariant,false)));
    QTRY_VERIFY_WITH_TIMEOUT(!panel->property("busy").toBool(),6000);
    const auto entries=groups().front().toMap().value("entries").toList();QCOMPARE(entries.size(),2);
    const auto saved=QDir(_settings.path()).filePath(entries[1].toMap().value("path").toString());
    std::unique_ptr<MasterScore> reopened(main->readScore(saved));QVERIFY(reopened);
    auto restored=toChord(reopened->tick2segment(Fraction::fromTicks(480),false,SegmentType::ChordRest)->element(0))->notes().front();
    QCOMPARE(restored->pitch(),pitch+1);
    reopened.reset();
    const auto openScores=main->scores().size();
    QVERIFY(QMetaObject::invokeMethod(panel,"setPanelFloating",Q_ARG(bool,true)));
    QVERIFY(QMetaObject::invokeMethod(panel,"resizePanel",Q_ARG(int,400),Q_ARG(int,740)));
    QTest::qWait(100);
    auto list=panel->findChild<QQuickItem*>("legacyVariantList");QVERIFY(list);
    const auto click=[panel](QQuickItem* item,const QPointF& position){
        QTest::mouseClick(panel->window(),Qt::LeftButton,Qt::NoModifier,item->mapToScene(position).toPoint());
    };
    click(list,QPointF(list->width()/2,82));
    QTRY_VERIFY(!panel->property("busy").toBool());QTRY_COMPARE(main->currentScore(),writing);
    QCOMPARE(main->scores().size(),openScores);
    writing->startCmd();writing->undoChangePitch(note,pitch+2,21,21);writing->endCmd();
    click(list,QPointF(list->width()/2,27));
    QTRY_VERIFY(!panel->property("busy").toBool());QTRY_VERIFY(main->currentScore()!=writing);
    reopened.reset(main->readScore(saved));QVERIFY(reopened);
    QCOMPARE(toChord(reopened->tick2segment(Fraction::fromTicks(480),false,SegmentType::ChordRest)->element(0))->notes().front()->pitch(),pitch+2);
    reopened.reset();
    click(list,QPointF(list->width()/2,82));QTRY_VERIFY(!panel->property("busy").toBool());
    auto remove=panel->findChild<QQuickItem*>("legacyDeleteWriting");QVERIFY(remove);
    click(remove,QPointF(remove->width()/2,remove->height()/2));
    QTRY_VERIFY(!panel->property("busy").toBool());
    QCOMPARE(groups().front().toMap().value("entries").toList().size(),1);
    QVERIFY(QFile::exists(saved));
    QVERIFY(invoke("newGroup"));QTRY_VERIFY(!panel->property("busy").toBool());QCOMPARE(groups().size(),2);
    auto otherGroup=groups()[1].toMap();otherGroup["name"]=QString::fromUtf8("第二组，保留改名");
    QVERIFY(QMetaObject::invokeMethod(panel,"setGroup",Q_ARG(QVariant,otherGroup)));
    auto restore=panel->findChild<QQuickItem*>("legacyRestoreWriting");QVERIFY(restore);QVERIFY(restore->isEnabled());
    click(restore,QPointF(restore->width()/2,restore->height()/2));QTRY_VERIFY(!panel->property("busy").toBool());
    QCOMPARE(groups().size(),2);QCOMPARE(groups()[1].toMap().value("name").toString(),QString::fromUtf8("第二组，保留改名"));
    QCOMPARE(groups().front().toMap().value("entries").toList().size(),2);
    QTRY_COMPARE(main->currentScore(),writing);QCOMPARE(note->pitch(),pitch+2);
    const QDir artifacts(qEnvironmentVariable("HARMONY_TEST_ARTIFACTS",_settings.path()));
    QVERIFY(panel->window()->grabWindow().save(artifacts.filePath("legacy-variants-076.png")));
    QVERIFY(QMetaObject::invokeMethod(panel,"resizePanel",Q_ARG(int,300),Q_ARG(int,420)));QTest::qWait(80);
    QVERIFY(panel->window()->grabWindow().save(artifacts.filePath("legacy-variants-narrow-076.png")));
    auto bar=panel->findChild<QQuickItem*>("legacyVariantScrollBar");
    auto content=panel->findChild<QQuickItem*>("legacyVariantContent");
    auto body=panel->findChild<QQuickItem*>("legacyVariantBody");
    auto help=panel->findChild<QQuickItem*>("legacyVariantHelp");
    QVERIFY(bar);QVERIFY(content);QVERIFY(body);QVERIFY(help);
    QVERIFY(content->mapToScene(QPointF(content->width(),0)).x()+3<=bar->mapToScene(QPointF()).x());
    auto flick=qobject_cast<QQuickItem*>(body->property("contentItem").value<QObject*>());QVERIFY(flick);
    QVERIFY(flick->setProperty("contentY",qMax(0.,flick->property("contentHeight").toDouble()-flick->height())));
    QTest::qWait(50);
    QVERIFY(help->mapToScene(QPointF(0,help->height())).y()<=body->mapToScene(QPointF(0,body->height())).y()+1);
    QVERIFY(panel->window()->grabWindow().save(artifacts.filePath("legacy-variants-narrow-bottom-076.png")));
    QVERIFY(QMetaObject::invokeMethod(panel,"resizePanel",Q_ARG(int,400),Q_ARG(int,740)));QTest::qWait(50);
    QVERIFY(invoke("duplicate"));QTRY_VERIFY(!panel->property("busy").toBool());
    const auto writingB=main->currentScore();QVERIFY(writingB!=writing);
    auto noteB=toChord(writingB->tick2segment(Fraction::fromTicks(480),false,SegmentType::ChordRest)->element(0))->notes().front();
    writingB->startCmd();writingB->undoChangePitch(noteB,65,13,13);writingB->endCmd();
    QVERIFY(QMetaObject::invokeMethod(panel,"switchTo",Q_ARG(QVariant,1),Q_ARG(QVariant,false)));
    QTRY_VERIFY(!panel->property("busy").toBool());QCOMPARE(main->currentScore(),writing);
    const auto bPath=QDir(_settings.path()).filePath(groups()[0].toMap().value("entries").toList()[2].toMap().value("path").toString());
    reopened.reset(main->readScore(bPath));QVERIFY(reopened);bool foundB=false;
    for(auto n:toChord(reopened->tick2segment(Fraction::fromTicks(480),false,SegmentType::ChordRest)->element(0))->notes())if(n->pitch()==65)foundB=true;
    QVERIFY(foundB);reopened.reset();
    auto damaged=groups()[0].toMap();auto damagedEntries=damaged.value("entries").toList();
    auto unreadable=damagedEntries.front().toMap();unreadable["id"]="unreadable-076";
    unreadable["name"]=QString::fromUtf8("需要检查的文件");unreadable["hash"]="intentionally-mismatched";
    damagedEntries.append(unreadable);damaged["entries"]=damagedEntries;
    QVERIFY(QMetaObject::invokeMethod(panel,"setGroup",Q_ARG(QVariant,damaged)));QTest::qWait(40);
    click(list,QPointF(list->width()/2,192));
    QTRY_COMPARE(panel->property("selected").toInt(),3);QCOMPARE(main->currentScore(),writing);
    click(remove,QPointF(remove->width()/2,remove->height()/2));QTRY_VERIFY(!panel->property("busy").toBool());
    const auto kept=groups()[0].toMap().value("entries").toList();QCOMPARE(kept.size(),3);
    for(const auto& entry:kept)QVERIFY(entry.toMap().value("id").toString()!="unreadable-076");
    QCOMPARE(QFileInfo(QDir(_settings.path()).filePath(kept[1].toMap().value("path").toString())).canonicalFilePath(),QFileInfo(saved).canonicalFilePath());
    QCOMPARE(main->currentScore(),writing);
    const auto validOther=groups()[1].toMap();auto blockedOther=validOther;
    auto blockedEntries=blockedOther.value("entries").toList();auto blockedBase=blockedEntries[0].toMap();
    blockedBase["hash"]="intentionally-mismatched";blockedEntries[0]=blockedBase;blockedOther["entries"]=blockedEntries;
    panel->setProperty("groupIndex",1);QVERIFY(QMetaObject::invokeMethod(panel,"setGroup",Q_ARG(QVariant,blockedOther)));
    QVERIFY(QMetaObject::invokeMethod(panel,"switchTo",Q_ARG(QVariant,0),Q_ARG(QVariant,false)));
    QCOMPARE(main->currentScore(),writing);
    writing->startCmd();writing->undoChangePitch(note,64,18,18);writing->endCmd();
    QVERIFY(invoke("saveActive"));QVERIFY(!writing->masterScore()->dirty());
    reopened.reset(main->readScore(saved));QVERIFY(reopened);bool foundCurrent=false;
    for(auto n:toChord(reopened->tick2segment(Fraction::fromTicks(480),false,SegmentType::ChordRest)->element(0))->notes())if(n->pitch()==64)foundCurrent=true;
    QVERIFY(foundCurrent);reopened.reset();
    QVERIFY(QMetaObject::invokeMethod(panel,"setGroup",Q_ARG(QVariant,validOther)));
    panel->setProperty("groupIndex",0);panel->setProperty("selected",1);QVERIFY(invoke("refresh"));
    QVERIFY(invoke("saveManifest"));
    const auto workspace=panel->property("workspace").toString();
    writing->startCmd();writing->undoChangePitch(note,67,15,15);writing->endCmd();
    QVERIFY(main->saveFile());QVERIFY(!writing->masterScore()->dirty());
    releaseHostPanels();panel=nullptr;
    const auto sourceIndex=main->scores().indexOf(source);QVERIFY(sourceIndex>=0);main->setCurrentScoreView(sourceIndex);
    main->pluginTriggered(QString(TESTROOT)+"/share/plugins/ArrangementVariants/ArrangementVariants_MS3.qml");
    for(auto window:QGuiApplication::allWindows())if(auto view=qobject_cast<QQuickView*>(window))
        if(auto root=qobject_cast<QmlPlugin*>(view->rootObject()))
            if(root->menuPath()=="Plugins.Arrangement Variants")panel=root;
    QVERIFY(panel);
    QVERIFY(QMetaObject::invokeMethod(panel,"load",Q_ARG(QVariant,workspace)));
    QTRY_VERIFY(!panel->property("busy").toBool());
    QTRY_VERIFY2(panel->property("status").toString().startsWith(QString::fromUtf8("范围外相同")),qUtf8Printable(panel->property("status").toString()));
    QCOMPARE(main->currentScore(),writing);QCOMPARE(note->pitch(),67);QCOMPARE(groups().size(),2);
    QVERIFY(QDir(_settings.path()).mkpath("moved-index"));
    const auto moved=QUrl::fromLocalFile(_settings.filePath(QString::fromUtf8("moved-index/第二份工作区.json"))).toString();
    QVERIFY(QMetaObject::invokeMethod(panel,"saveAt",Q_ARG(QVariant,moved)));
    QCOMPARE(panel->property("workspace").toString(),moved);
    const auto relative=groups()[0].toMap().value("entries").toList()[1].toMap().value("path").toString();
    QCOMPARE(QFileInfo(QDir(_settings.filePath("moved-index")).filePath(relative)).canonicalFilePath(),QFileInfo(saved).canonicalFilePath());
    QVERIFY(QFile::exists(QUrl(workspace).toLocalFile()));QVERIFY(QFile::exists(QUrl(moved).toLocalFile()));
    while(!groups().isEmpty()){
        const auto count=groups().size();QVERIFY(invoke("removeGroup"));
        QTRY_VERIFY(!panel->property("busy").toBool());QCOMPARE(groups().size(),count-1);
    }
    QVERIFY(QMetaObject::invokeMethod(panel,"load",Q_ARG(QVariant,moved)));
    QCOMPARE(panel->property("groupIndex").toInt(),-1);QVERIFY(groups().isEmpty());
    QVERIFY(panel->property("status").toString().startsWith(QString::fromUtf8("工作区已打开")));
    QVERIFY(invoke("newGroup"));QTRY_VERIFY(!panel->property("busy").toBool());
    QCOMPARE(groups().size(),1);QVERIFY(!main->currentScore()->masterScore()->readOnly());
    QVERIFY(QFile::exists(saved));QVERIFY(QFile::exists(bPath));
    QCOMPARE(source->state(),sourceState);QCOMPARE(source->undoStack()->getCurIdx(),sourceUndo);
    releaseHostPanels();
}
