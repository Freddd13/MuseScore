static QmlPlugin* arrangementPanel116()
{
    for(auto window:QGuiApplication::allWindows())if(auto view=qobject_cast<QQuickView*>(window))
        if(auto root=qobject_cast<QmlPlugin*>(view->rootObject()))if(root->menuPath()=="Plugins.Arrangement Check")return root;
    return nullptr;
}

