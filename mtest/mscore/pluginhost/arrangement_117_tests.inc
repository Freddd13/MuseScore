static QByteArray arrangementPrefixScore117(bool separate=false)
{
    QByteArray xml="<museScore version=\"3.02\"><Score><Division>480</Division>";
    if(separate)for(int staff=1;staff<=2;++staff)xml+="<Part><Staff id=\""+QByteArray::number(staff)+"\"><StaffType group=\"pitched\"/></Staff><trackName>Piano</trackName><Instrument id=\"piano\"><Channel/></Instrument></Part>";
    else xml+="<Part><Staff id=\"1\"><StaffType group=\"pitched\"/></Staff><Staff id=\"2\"><StaffType group=\"pitched\"/></Staff><trackName>Piano</trackName><Instrument id=\"piano\"><Channel/></Instrument></Part>";
    for(int staff=1;staff<=2;++staff){xml+="<Staff id=\""+QByteArray::number(staff)+"\">";for(int bar=0;bar<6;++bar){xml+="<Measure><voice>";if(!bar)xml+="<Clef><concertClefType>"+QByteArray(staff==1?"G":"F")+"</concertClefType><transposingClefType>"+QByteArray(staff==1?"G":"F")+"</transposingClefType></Clef><TimeSig><sigN>4</sigN><sigD>4</sigD></TimeSig>";
        if(bar<2&&(staff==1||separate)){const int root=staff==1?(bar?14:15):(bar?13:16);xml+="<Harmony><root>"+QByteArray::number(root)+"</root><name></name></Harmony>";}
        xml+="<Chord><durationType>whole</durationType>";if(staff==1)xml+="<Note><pitch>73</pitch><tpc>21</tpc></Note>";else for(const auto& row:QList<QPair<int,int>>{{60,14},{64,18},{67,15}})xml+="<Note><pitch>"+QByteArray::number(row.first)+"</pitch><tpc>"+QByteArray::number(row.second)+"</tpc></Note>";xml+="</Chord></voice></Measure>";}xml+="</Staff>";}return xml+"</Score></museScore>";
}

