void TestPluginHost::arrangementPrefixParts117()
{
    const auto path=_settings.filePath("arrangement-prefix-parts-117.mscx");QFile file(path);QVERIFY(file.open(QIODevice::WriteOnly));file.write(arrangementPrefixScore117(true));file.close();auto main=Ms::mscore;auto score=main->readScore(path);QVERIFY(score);main->setCurrentScoreView(main->appendScore(score));PluginAPI::Score wrapped(score);PluginAPI::ScoreObserver observer;observer.setScore(&wrapped);const auto contentRevision=observer.analysisRevision();const auto state=score->state();int cursor=5760,pages=0;QMap<int,QVariantMap> latest;qreal worst=0;
    while(cursor>0){const auto page=observer.analysisHarmonyContext(5760,0,8,cursor,1,contentRevision);QVERIFY(!page.contains("error"));worst=qMax(worst,page.value("milliseconds").toDouble());for(const auto& value:page.value("harmonies").toList()){const auto row=value.toMap();if(!latest.contains(row.value("part").toInt()))latest[row.value("part").toInt()]=row;}++pages;const int following=page.value("nextTick").toInt();if(page.value("done").toBool())break;QVERIFY(following<cursor);cursor=following;QVERIFY(pages<10);}
    QCOMPARE(pages,3);QCOMPARE(latest.size(),2);QCOMPARE(latest[0].value("rootTpc").toInt(),14);QCOMPARE(latest[4].value("rootTpc").toInt(),13);const auto other=observer.analysisHarmonyContext(5760,4,8,5760,64,contentRevision);QCOMPARE(other.value("harmonies").toList().size(),2);for(const auto& value:other.value("harmonies").toList())QCOMPARE(value.toMap().value("part").toInt(),4);
    const auto boundary=observer.analysisHarmonyContext(1920,0,4,1920,64,contentRevision);QCOMPARE(boundary.value("harmonies").toList().size(),1);QCOMPARE(boundary.value("harmonies").toList().front().toMap().value("rootTpc").toInt(),15);QVERIFY(observer.analysisHarmonyContext(0,0,8,0,64,contentRevision).value("done").toBool());PluginAPI::ScoreObserver empty;QCOMPARE(empty.analysisHarmonyContext(0,0,8,0,1).value("error").toString(),QString("no-score"));QVERIFY(score->state()==state);qInfo()<<"PREFIX117 pages"<<pages<<"worst milliseconds"<<worst;main->closeScore(score);
}

