 void expressionPartialApplicationMouse(){
  auto score=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/scoreobserver/piano.mscx");QVERIFY(score);mscore->setCurrentScoreView(mscore->appendScore(score));mscore->resize(1250,900);mscore->show();
  const QString path=QString(TESTROOT)+"/share/plugins/PerformanceExpression/PerformanceExpression_MS3.qml";PluginDescription description;description.path=path;QVERIFY(collectPluginMetaInformation(&description));mscore->registerPlugin(&description);mscore->pluginTriggered(path);QTest::qWait(100);
  QmlPlugin* root=nullptr;for(auto window:QGuiApplication::allWindows()){auto view=qobject_cast<QQuickView*>(window);auto item=view?qobject_cast<QmlPlugin*>(view->rootObject()):nullptr;if(item&&item->property("menuPath").toString().endsWith("Performance Expression"))root=item;}QVERIFY(root);
  floatWorkflowPanel(root);root->focusPanel();QTest::qWait(100);
  auto observer=qobject_cast<PluginAPI::ScoreObserver*>(root->property("observer").value<QObject*>());QVERIFY(observer);observer->workflowInfo();auto scope=observer->analysisScope(true);auto revision=observer->analysisRevision();auto page=observer->performanceRange(0,scope["end"].toInt(),0,score->ntracks(),0,100,revision);auto notes=page["notes"].toList();QVERIFY(notes.size()>2);
  QVariantList matches,performance;for(int i=0;i<notes.size();++i){auto n=notes[i].toMap();performance.append(QVariantMap{{"id",QString("m%1").arg(i)},{"pitch",n["pitch"]},{"seconds",n["scoreSeconds"]},{"velocity",100}});matches.append(QVariantMap{{"original",n},{"tick",n["tick"]},{"track",n["track"]},{"index",n["index"]},{"pitch",n["pitch"]},{"seconds",n["scoreSeconds"]},{"scoreId",n["id"]},{"midiId",QString("m%1").arg(i)},{"velocity",100},{"confirmed",true},{"confidence",1.},{"status","匹配"}});}
  root->setProperty("scope",scope);root->setProperty("notes",notes);root->setProperty("revision",revision);root->setProperty("midi",QVariantMap{{"notes",performance},{"sha256","partial-test"}});root->setProperty("result",QVariantMap{{"matches",matches},{"pending",0},{"missing",QVariantList{}},{"extra",QVariantList{}}});
  auto count=[&](){return root->property("scopedCandidate").value<QJSValue>().toVariant().toMap()["velocity"].toList().size();};
  root->setProperty("applicationScope",2);QTRY_VERIFY(count()>2);const int total=count();
