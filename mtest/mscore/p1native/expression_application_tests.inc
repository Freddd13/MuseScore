  score->select(note,SelectType::SINGLE);root->setProperty("liveSelection",observer->expressionSelection());root->setProperty("applicationScope",0);QTRY_COMPARE(count(),1);
  auto click=[&](const char* name){QTest::qWait(50);if(root->property("embeddedWorkflow").toBool()&&(QString(name)=="expressionLocate"||QString(name)=="expressionConfirm"||QString(name)=="expressionOpenEditor")){QMetaObject::invokeMethod(root,"showMoreActions");QTest::qWait(60);}auto item=root->findChild<QQuickItem*>(name);if(!item||!item->isEnabled()||!item->isVisible())return false;QTest::mouseClick(item->window(),Qt::LeftButton,Qt::NoModifier,item->mapToScene(QPointF(item->width()/2,item->height()/2)).toPoint());return true;};
  const int undo=score->undoStack()->getCurIdx();QVERIFY(click("expressionApplyVelocity"));QTRY_VERIFY(!root->property("busy").toBool());QTRY_VERIFY(!root->property("candidate").value<QJSValue>().isNull());QVERIFY(!root->property("stale").toBool());QCOMPARE(score->undoStack()->getCurIdx(),undo+1);QVERIFY(note->veloOffset()!=original);QCOMPARE(observer->expressionVelocityHistory({})["count"].toInt(),1);
  root->setProperty("applicationScope",2);QTRY_COMPARE(count(),total-1);QVERIFY(click("expressionApplyVelocity"));QTRY_VERIFY(!root->property("busy").toBool());QTRY_COMPARE(count(),0);QVERIFY(!root->property("stale").toBool());QCOMPARE(score->undoStack()->getCurIdx(),undo+2);QCOMPARE(observer->expressionVelocityHistory({})["count"].toInt(),total);
  root->setProperty("applicationScope",0);root->setProperty("liveSelection",observer->expressionSelection());QVERIFY(click("expressionApplicationMenuButton"));QVERIFY(click("expressionRestoreVelocity"));QTRY_VERIFY(!root->property("busy").toBool());QTRY_COMPARE(note->veloOffset(),original);QCOMPARE(score->undoStack()->getCurIdx(),undo+3);
  EditData edit;score->undoRedo(true,&edit);QVERIFY(note->veloOffset()!=original);
  root->setVisible(false);root->deleteLater();QTest::qWait(50);
 }
