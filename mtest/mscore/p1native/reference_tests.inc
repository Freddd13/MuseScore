 void TestP1Native::referenceClockAndPlan(){
  auto s=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/scoreobserver/piano.mscx");QVERIFY(s);mscore->setCurrentScoreView(mscore->appendScore(s));PluginAPI::Score w(s);PluginAPI::ScoreObserver o;o.setScore(&w);auto scope=o.analysisScope(false);int start=scope["start"].toInt(),end=scope["end"].toInt();double seconds=s->utick2utime(end)-s->utick2utime(start);
  QVariantMap association{{"start",start},{"end",end},{"from",0},{"until",seconds*1000},{"active",true},{"occurrence",1}};
  QVariantMap track{{"id","a"},{"name","原曲"},{"path","source.wav"},{"speed",.75},{"associations",QVariantList{association}}};
  QVariantMap request{{"revision",o.analysisRevision()},{"start",start},{"end",end},{"tracks",QVariantList{track}},{"leader",association},{"speed",1.},{"mode",0}};auto state=s->state();int undo=s->undoStack()->getCurIdx();
  auto independent=o.referencePlan(request);QVERIFY2(independent["ok"].toBool(),qPrintable(independent["error"].toString()));auto piece=independent["clips"].toList()[0].toMap()["pieces"].toList()[0].toMap();QVERIFY(std::abs(piece["duration"].toDouble()-seconds*1000/.75)<.01);
  request["mode"]=1;auto following=o.referencePlan(request);QVERIFY(following["ok"].toBool());piece=following["clips"].toList()[0].toMap()["pieces"].toList()[0].toMap();QVERIFY(std::abs(piece["duration"].toDouble()-seconds*1000)<.01);QCOMPARE(following["clips"].toList()[0].toMap()["pieces"].toList().size(),1);
  association["until"]=seconds*1200;request["leader"]=association;request["mode"]=2;auto audioLed=o.referencePlan(request);QVERIFY(audioLed["ok"].toBool());QVector<QPair<double,double>> clock;for(auto v:audioLed["clock"].toList()){auto p=v.toMap();clock.append({p["score"].toDouble(),p["output"].toDouble()});}setReferenceClock(clock);for(double time:{-.1,0.,seconds*.25,seconds*.75,seconds+.1})QVERIFY(std::abs(referenceScoreTime(referenceOutputTime(time))-time)<1e-9);setReferenceClock({});QCOMPARE(referenceOutputTime(12.3),12.3);
  auto first=association,second=association;const int middle=start+(end-start)/2;
  first["end"]=middle;first["until"]=seconds*700;second["start"]=middle;second["from"]=seconds*1500;second["until"]=seconds*2000;
  track["associations"]=QVariantList{second,first};request["tracks"]=QVariantList{track};request["mode"]=0;
  auto sequence=o.referencePlan(request);QVERIFY2(sequence["ok"].toBool(),qPrintable(sequence["error"].toString()));auto pieces=sequence["clips"].toList().front().toMap()["pieces"].toList();QCOMPARE(pieces.size(),2);auto initial=pieces.front().toMap(),next=pieces.back().toMap();QVERIFY(std::abs(next["at"].toDouble()-initial["duration"].toDouble())<.01);
  second["start"]=middle-60;track["associations"]=QVariantList{first,second};request["tracks"]=QVariantList{track};QVERIFY(o.referencePlan(request)["error"].toString().contains(QString::fromUtf8("本次")));
  second["active"]=false;track["associations"]=QVariantList{first,second};request["tracks"]=QVariantList{track};QVERIFY(o.referencePlan(request)["ok"].toBool());
  request["revision"]="old";QVERIFY(o.referencePlan(request).contains("error"));QVERIFY(s->state()==state);QCOMPARE(s->undoStack()->getCurIdx(),undo);
 }
