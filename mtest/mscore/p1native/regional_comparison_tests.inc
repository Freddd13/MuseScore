void TestP1Native::regionalCombinationAndDifferences(){
 auto score=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/p0native/longroot.mscx");QVERIFY(score);mscore->setCurrentScoreView(mscore->appendScore(score));
 const int until=score->firstMeasure()->endTick().ticks();
 auto left=RegionalVariants::create(score,0,until,{4},"左手"),right=RegionalVariants::create(score,0,until,{0},"右手");QVERIFY(left["ok"].toBool()&&right["ok"].toBool());
 auto b=RegionalVariants::duplicate(score,left["group"].toString(),"B",true),c=RegionalVariants::duplicate(score,right["group"].toString(),"B",true);QVERIFY(b["ok"].toBool()&&c["ok"].toBool());
 auto note=[&](int track){auto cr=score->findCR(Fraction::fromTicks(track==0?480:0),track);return cr&&cr->isChord()?toChord(cr)->upNote():nullptr;};QVERIFY(note(0)&&note(4));
 score->startCmd();note(4)->undoChangeProperty(Pid::VELO_OFFSET,27);note(0)->undoChangeProperty(Pid::VELO_OFFSET,-10);score->endCmd();
 auto combination=RegionalVariants::storeCombination(score,"两手B");QVERIFY(combination["ok"].toBool());
 const auto state=score->state();const auto filename=score->fileInfo()->filePath();const bool dirty=score->dirty();const int undo=score->undoStack()->getCurIdx();
 QString problem;std::unique_ptr<MasterScore> other(RegionalVariants::comparison(score,left["group"].toString(),left["variant"].toString(),&problem));QVERIFY2(other,qPrintable(problem));
 QVERIFY(score->state()==state);QCOMPARE(score->undoStack()->getCurIdx(),undo);QCOMPARE(score->fileInfo()->filePath(),filename);QCOMPARE(score->dirty(),dirty);QCOMPARE(note(4)->veloOffset(),27);
 const auto changes=RegionalVariants::differences(score,other.get(),left["group"].toString());QVERIFY(!changes.isEmpty());QVERIFY(changes.front().toMap()["types"].toStringList().contains(QString::fromUtf8("力度")));QCOMPARE(toChord(other->findCR(Fraction::fromTicks(0),4))->upNote()->veloOffset(),0);
 QVariantMap choices{{left["group"].toString(),left["variant"]},{right["group"].toString(),right["variant"]}};
 auto bad=choices;bad["missing-group"]="missing-writing";QVERIFY(RegionalVariants::selectMany(score,bad).contains("error"));QCOMPARE(score->undoStack()->getCurIdx(),undo);QCOMPARE(note(4)->veloOffset(),27);
 QVERIFY(RegionalVariants::selectMany(score,choices)["ok"].toBool());QCOMPARE(score->undoStack()->getCurIdx(),undo+1);QCOMPARE(note(4)->veloOffset(),0);QCOMPARE(note(0)->veloOffset(),0);
 EditData ed;score->undoRedo(true,&ed);QCOMPARE(note(4)->veloOffset(),27);QCOMPARE(note(0)->veloOffset(),-10);score->undoRedo(false,&ed);
 const int before=score->undoStack()->getCurIdx();QVERIFY(RegionalVariants::selectCombination(score,combination["id"].toString())["ok"].toBool());QCOMPARE(score->undoStack()->getCurIdx(),before+1);QCOMPARE(note(4)->veloOffset(),27);QCOMPARE(note(0)->veloOffset(),-10);
 const auto path=settings.filePath("combinations-052.mscz");QFileInfo info(path);QVERIFY(score->saveCompressedFile(info,false,false));std::unique_ptr<MasterScore> restored(mscore->readScore(path));QVERIFY(restored);QCOMPARE(RegionalVariants::state(restored.get())["combinations"].toList().size(),1);QCOMPARE(toChord(restored->findCR(Fraction::fromTicks(0),4))->upNote()->veloOffset(),27);
 QBuffer ordinary;ordinary.open(QIODevice::WriteOnly);QVERIFY(RegionalVariants::exportOrdinary(score,&ordinary,"ordinary.mscx",true));auto bytes=ordinary.data();QBuffer ordinaryInput(&bytes);ordinaryInput.open(QIODevice::ReadOnly);MasterScore plain(score->style());QCOMPARE(plain.loadCompressedMsc(&ordinaryInput,true),Score::FileError::FILE_NO_ERROR);QVERIFY(RegionalVariants::state(&plain)["groups"].toList().isEmpty());
 QBuffer normalInput;QFile normalFile(path);QVERIFY(normalFile.open(QIODevice::ReadOnly));normalInput.setData(normalFile.readAll());normalInput.open(QIODevice::ReadOnly);MQZipReader archive(&normalInput);QByteArray normalXml;for(auto f:archive.fileInfoList())if(f.isFile&&f.filePath.endsWith(".mscx")){normalXml=archive.fileData(f.filePath);break;}QVERIFY(!normalXml.isEmpty());XmlReader reader(normalXml);MasterScore normal(score->style());QCOMPARE(normal.read1(reader,true),Score::FileError::FILE_NO_ERROR);QCOMPARE(toChord(normal.findCR(Fraction::fromTicks(0),4))->upNote()->veloOffset(),0);QCOMPARE(note(4)->veloOffset(),27);
 QVERIFY(RegionalVariants::selectMany(score,choices)["ok"].toBool());QVERIFY(RegionalVariants::storeCombination(score,"两手B")["ok"].toBool());QCOMPARE(RegionalVariants::state(score)["combinations"].toList().size(),1);
}
void TestP1Native::regionalComparisonMouseAndWheel(){
 auto score=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/p0native/longroot.mscx");QVERIFY(score);mscore->setCurrentScoreView(mscore->appendScore(score));mscore->resize(1280,950);mscore->show();
 auto group=RegionalVariants::create(score,0,score->firstMeasure()->endTick().ticks(),{4},"左手伴奏");QVERIFY(group["ok"].toBool());auto second=RegionalVariants::duplicate(score,group["group"].toString(),"B",true);QVERIFY(second["ok"].toBool());
 auto note=[&]{return toChord(score->findCR(Fraction::fromTicks(0),4))->upNote();};score->startCmd();note()->undoChangeProperty(Pid::VELO_OFFSET,25);score->undoChangePitch(note(),note()->pitch()+2,note()->tpc1()+2,note()->tpc2()+2);score->endCmd();
 showRegionalVariantPanel(group["group"].toString());auto dock=mscore->findChild<QDockWidget*>("kumoPanel/regionalVariantsDock");QVERIFY(dock);dock->setFloating(true);dock->resize(470,800);dock->show();dock->raise();QTest::qWait(100);
 auto compare=dock->findChild<QCheckBox*>("regionalCompare");QVERIFY(compare);QTest::mouseClick(compare,Qt::LeftButton,Qt::NoModifier,QPoint(10,compare->height()/2));auto changes=dock->findChild<QTreeWidget*>("regionalDifferences");QTRY_VERIFY(changes&&changes->topLevelItemCount()>0);
 auto view=mscore->currentScoreView();auto overlay=view->findChild<QWidget*>("regionalDifferenceLayer");QVERIFY(overlay&&overlay->isVisible());QVERIFY(overlay->property("differenceCount").toInt()>0);class PaintCount:public QObject{public:int count=0;bool eventFilter(QObject*,QEvent* e)override{count+=e->type()==QEvent::Paint;return false;}} paintCount;view->installEventFilter(&paintCount);QTest::qWait(80);view->removeEventFilter(&paintCount);QVERIFY2(paintCount.count<20,"comparison repeatedly repainted the idle score");
 const int undo=score->undoStack()->getCurIdx();auto item=changes->topLevelItem(0);QTest::mouseClick(changes->viewport(),Qt::LeftButton,Qt::NoModifier,changes->visualItemRect(item).center());QCOMPARE(score->undoStack()->getCurIdx(),undo);
 auto combo=RegionalVariants::storeCombination(score,"左手B");QVERIFY(combo["ok"].toBool());QTest::qWait(550);auto combinations=dock->findChild<QComboBox*>("regionalCombinations");QVERIFY(combinations);QVERIFY(combinations->findData(combo["id"])>0);
 setRegionalControlsVisible(true);view->update();QToolButton* switcher=nullptr;QTRY_VERIFY(([&]{switcher=view->findChild<QToolButton*>("regionalScoreSwitch/"+group["group"].toString());return switcher&&switcher->isVisible();})());
 const auto point=switcher->rect().center();QWheelEvent wheel(QPointF(point),QPointF(switcher->mapToGlobal(point)),QPoint(),QPoint(0,-120),Qt::NoButton,Qt::ControlModifier,Qt::NoScrollPhase,false);QApplication::sendEvent(switcher,&wheel);QCOMPARE(note()->veloOffset(),0);QVERIFY(wheel.isAccepted());QTest::qWait(600);
 QVERIFY(RegionalVariants::selectCombination(score,combo["id"].toString())["ok"].toBool());QCOMPARE(note()->veloOffset(),25);QTest::qWait(600);
 auto listen=dock->findChild<QCheckBox*>("regionalAuditionCompare");QVERIFY(listen);QTest::mouseClick(listen,Qt::LeftButton,Qt::NoModifier,QPoint(10,listen->height()/2));QVERIFY(regionalAuditionEnabled());QTest::mouseClick(listen,Qt::LeftButton,Qt::NoModifier,QPoint(10,listen->height()/2));QVERIFY(!regionalAuditionEnabled());
 const auto output=qEnvironmentVariable("HARMONY_TEST_ARTIFACTS");if(!output.isEmpty()){dock->grab().save(output+"/regional-comparison-panel-052.png");view->grab().save(output+"/regional-comparison-score-052.png");}
 QTest::mouseClick(compare,Qt::LeftButton,Qt::NoModifier,QPoint(10,compare->height()/2));QVERIFY(!overlay->isVisible());dock->hide();
 QList<QPointer<QDockWidget>> hiddenDocks;for(auto d:mscore->findChildren<QDockWidget*>(QString(),Qt::FindDirectChildrenOnly))if(d->isVisible()){hiddenDocks.append(d);d->hide();}
 auto rhythm=[&](bool sparse){QString xml="<museScore version=\"3.02\"><Score><Division>480</Division><Part><Staff id=\"1\"><StaffType group=\"pitched\"><name>stdNormal</name></StaffType></Staff><Instrument id=\"piano\"><instrumentId>keyboard.piano</instrumentId><Channel/></Instrument></Part><Staff id=\"1\"><Measure><voice><TimeSig><sigN>4</sigN><sigD>4</sigD></TimeSig>";for(int i=0;i<(sparse?6:8);++i)xml+=QString("<Chord><durationType>%1</durationType><Note><pitch>%2</pitch><tpc>14</tpc></Note></Chord>").arg(sparse&&i<2?"quarter":"eighth").arg(60+(i%2)*12);xml+="</voice></Measure></Staff></Score></museScore>";const auto path=settings.filePath(sparse?"sparse-052.mscx":"eighths-052.mscx");QFile file(path);if(!file.open(QIODevice::WriteOnly))return static_cast<MasterScore*>(nullptr);file.write(xml.toUtf8());file.close();return mscore->readScore(path);};
 auto melody=rhythm(false);std::unique_ptr<MasterScore> sparse(rhythm(true));QVERIFY(melody&&sparse);mscore->setCurrentScoreView(mscore->appendScore(melody));auto melodyView=mscore->currentScoreView();
 const auto melodyGroup=RegionalVariants::create(melody,0,1920,{0},"节奏比较");QVERIFY(melodyGroup["ok"].toBool());const auto variant=RegionalVariants::importVersion(melody,sparse.get(),melodyGroup["group"].toString(),"B");QVERIFY(variant["ok"].toBool());QVERIFY(RegionalVariants::select(melody,melodyGroup["group"].toString(),variant["variant"].toString())["ok"].toBool());
 QString problem;std::unique_ptr<MasterScore> eighths(RegionalVariants::comparison(melody,melodyGroup["group"].toString(),melodyGroup["variant"].toString(),&problem));QVERIFY2(eighths,qPrintable(problem));const auto rows=RegionalVariants::differences(melody,eighths.get(),melodyGroup["group"].toString());QVERIFY(!rows.isEmpty());bool beam=false;for(auto seg=eighths->firstSegment(SegmentType::ChordRest);seg;seg=seg->next1(SegmentType::ChordRest)){auto e=seg->element(0);if(e&&e->isChord())beam|=toChord(e)->beam()!=nullptr;}QVERIFY(beam);
 const auto content=melody->state();const int before=melody->undoStack()->getCurIdx();showRegionalDifference(melodyView,eighths.get(),rows);QTest::qWait(30);const QPoint center(450,220);QWheelEvent zoom(QPointF(center),QPointF(melodyView->mapToGlobal(center)),QPoint(),QPoint(0,240),Qt::NoButton,Qt::ControlModifier,Qt::NoScrollPhase,false);QApplication::sendEvent(melodyView,&zoom);mscore->resize(1080,850);QTest::qWait(50);if(!output.isEmpty())melodyView->grab().save(output+"/regional-rhythm-overlay-052.png");QVERIFY(melody->state()==content);QCOMPARE(melody->undoStack()->getCurIdx(),before);showRegionalDifference(melodyView,nullptr,{});for(auto d:hiddenDocks)if(d)d->show();

