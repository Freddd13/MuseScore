void TestP1Native::gateManualReleaseAndAudition(){
 QScopedValueRollback<bool> repeats(MScore::playRepeats,true);
 for(bool repeated:{false,true}){
  auto score=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/p0native/longroot.mscx");QVERIFY(score);mscore->setCurrentScoreView(mscore->appendScore(score));
  auto pedal=new Pedal(score);pedal->setTick(Fraction::fromTicks(0));pedal->setTicks(Fraction::fromTicks(1920));pedal->setTrack(4);pedal->setTrack2(4);score->addSpanner(pedal);if(repeated){score->firstMeasure()->setRepeatCount(2);score->firstMeasure()->setRepeatEnd(true);}score->setPlaylistDirty();
  ExportMidi exporter(score);exporter.collectGateData=true;QBuffer buffer;buffer.open(QIODevice::WriteOnly);QVERIFY(exporter.write(&buffer,true,true,mscore->synthesizerState()));
  MidiGateOptions options;options.jitter=0;MidiGateProcessor processor;auto rows=processor.process(exporter.gateData,options);int changed=0,index=-1;
  for(int i=0;i<rows.size();++i)if(rows[i].newOff<rows[i].off){++changed;QVERIFY(rows[i].sourceUtick>=0);if(index<0)index=i;}
  QVERIFY(changed>0);QVERIFY(index>=0);const auto bounds=processor.releaseBounds(rows[index],exporter.gateData.pedals,options);QVERIFY(bounds.first>rows[index].on);QCOMPARE(bounds.second,rows[index].off);
  const int manual=(bounds.first+bounds.second)/2;options.releaseOverrides[rows[index].id]=manual;auto manualRows=processor.process(exporter.gateData,options);QCOMPARE(manualRows[index].newOff,manual);QCOMPARE(manualRows[index].reason,QString("manual-release"));
  auto same=processor.process(exporter.gateData,options);QCOMPARE(same.size(),manualRows.size());for(int i=0;i<same.size();++i)QCOMPARE(same[i].newOff,manualRows[i].newOff);
  options.releaseOverrides[rows[index].id]=rows[index].off;auto restored=processor.process(exporter.gateData,options);QCOMPARE(restored[index].newOff,restored[index].off);QCOMPARE(restored[index].reason,QString("manual-original"));
  options.releaseOverrides[rows[index].id]=rows[index].off+100;auto invalid=processor.process(exporter.gateData,options);QCOMPARE(invalid[index].newOff,rows[index].newOff);
  auto protectedOptions=options;protectedOptions.protectedTracks.insert(rows[index].voice);QCOMPARE(processor.releaseBounds(rows[index],exporter.gateData.pedals,protectedOptions).first,-1);
  const auto content=score->state();const int undo=score->undoStack()->getCurIdx();auto playback=prepareGateAudition(score,exporter.gateData,manualRows);QCOMPARE(playback.unmatched,0);QVERIFY(playback.changed>0);QCOMPARE(playback.original.events.size(),playback.proposed.events.size());
  QStringList before,after;auto values=[](const EventMap& events,QStringList* values){for(const auto& item:events){const auto& e=item.second;if(e.type()==ME_NOTEOFF||(e.type()==ME_NOTEON&&e.velo()==0))continue;values->append(QString("%1:%2:%3:%4:%5").arg(item.first).arg(e.type()).arg(e.channel()).arg(e.pitch()).arg(e.velo()));}};
  values(playback.original.events,&before);values(playback.proposed.events,&after);QCOMPARE(before,after);QCOMPARE(score->undoStack()->getCurIdx(),undo);QVERIFY(score->state()==content);
 }
}
