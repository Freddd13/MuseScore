// Real panel switching and edits; independent scores and settings. GPL v2.
void TestP1Native::regionalEditedWritingsRoundTrip() {
      auto score = mscore->readScore(QString(TESTROOT) + "/mtest/mscore/p0native/longroot.mscx");
      QVERIFY(score);
      mscore->setCurrentScoreView(mscore->appendScore(score));
      auto made = RegionalVariants::create(score, 0, score->firstMeasure()->endTick().ticks(), {4}, "左手");
      QVERIFY(made["ok"].toBool());
      const auto group = made["group"].toString(), a = made["variant"].toString();
      auto note = [&] { return toChord(score->findCR(Fraction::fromTicks(0), 4))->downNote(); };
      const int original = note()->pitch();
      score->select(note());
      mscore->cmd(getAction("pitch-up"));
      QCOMPARE(note()->pitch(), original + 1);
      score->startCmd(); note()->undoChangeProperty(Pid::VELO_OFFSET, 23); score->endCmd();
      auto copied = RegionalVariants::duplicate(score, group, "B", true);
      QVERIFY(copied["ok"].toBool());
      const auto b = copied["variant"].toString();
      score->select(note()); mscore->cmd(getAction("pitch-up-octave"));
      QCOMPARE(note()->pitch(), original + 13);
      score->startCmd(); note()->undoChangeProperty(Pid::VELO_OFFSET, -12); score->endCmd();
      score->startCmd();
      score->changeCRlen(note()->chord(),Fraction(1,2));
      auto added = new Note(score); added->setParent(note()->chord()); added->setTrack(4);
      added->setPitch(original+20); added->setTpcFromPitch(); score->undoAddElement(added);
      score->endCmd();
      QCOMPARE(note()->chord()->actualTicks().ticks(),960);
      showRegionalVariantPanel(group);
      auto dock = mscore->findChild<QDockWidget*>("kumoPanel/regionalVariantsDock");
      QVERIFY(dock); dock->setFloating(true); dock->resize(550,760); dock->show();
      auto switchTo = [&](const QString &id) {
            auto button = dock->findChild<QPushButton*>("regionalQuick/" + id);
            if (!button) return false;
            QTest::mouseClick(button, Qt::LeftButton); QTest::qWait(20);
            return RegionalVariants::state(score)["groups"].toList()[0].toMap()["active"].toString() == id;
      };
      for (int i=0; i<3; ++i) {
            QVERIFY(switchTo(a)); QCOMPARE(note()->pitch(), original+1); QCOMPARE(note()->veloOffset(),23);
            QCOMPARE(note()->chord()->actualTicks().ticks(),1920);QCOMPARE(note()->chord()->notes().size(),size_t(1));
            QVERIFY(switchTo(b)); QCOMPARE(note()->pitch(), original+13); QCOMPARE(note()->veloOffset(),-12);
            QCOMPARE(note()->chord()->actualTicks().ticks(),960);QCOMPARE(note()->chord()->notes().size(),size_t(2));
      }
      QVERIFY(switchTo(a));
      score->select(note()); mscore->cmd(getAction("pitch-down"));
      score->startCmd(); note()->undoChangeProperty(Pid::VELO_OFFSET,31); score->endCmd();
      QVERIFY(switchTo(b)); QCOMPARE(note()->pitch(),original+13); QCOMPARE(note()->veloOffset(),-12);
      QVERIFY(switchTo(a)); QCOMPARE(note()->pitch(),original); QCOMPARE(note()->veloOffset(),31);
      QVERIFY(switchTo(b));
      const auto path = settings.filePath("regional-edits-070.mscz");
      QFileInfo info(path); QVERIFY2(score->saveCompressedFile(info,false,false),qPrintable(MScore::lastError));
      std::unique_ptr<MasterScore> reopened(mscore->readScore(path)); QVERIFY(reopened);
      auto restored = [&] { return toChord(reopened->findCR(Fraction::fromTicks(0),4))->downNote(); };
      QCOMPARE(restored()->pitch(),original+13); QCOMPARE(restored()->veloOffset(),-12);
      QCOMPARE(restored()->chord()->actualTicks().ticks(),960);QCOMPARE(restored()->chord()->notes().size(),size_t(2));
      QVERIFY(RegionalVariants::select(reopened.get(),group,a)["ok"].toBool());
      QCOMPARE(restored()->pitch(),original); QCOMPARE(restored()->veloOffset(),31);
      QCOMPARE(restored()->chord()->actualTicks().ticks(),1920);QCOMPARE(restored()->chord()->notes().size(),size_t(1));
      QVERIFY(RegionalVariants::select(reopened.get(),group,b)["ok"].toBool());
      QCOMPARE(restored()->pitch(),original+13); QCOMPARE(restored()->veloOffset(),-12);
      dock->hide();
}
void TestP1Native::regionalDeleteUndoAndReopen() {
      auto score=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/p0native/longroot.mscx");
      QVERIFY(score);mscore->setCurrentScoreView(mscore->appendScore(score));
      const auto a=RegionalVariants::create(score,0,1920,{4},"左手");QVERIFY(a["ok"].toBool());
      const auto group=a["group"].toString(),original=a["variant"].toString();
      const auto b=RegionalVariants::duplicate(score,group,"B",true);QVERIFY(b["ok"].toBool());
      auto note=[&]{return toChord(score->findCR(Fraction::fromTicks(0),4))->upNote();};
      score->startCmd();note()->undoChangeProperty(Pid::VELO_OFFSET,35);score->endCmd();
      QVERIFY(RegionalVariants::chooseMain(score,group,b["variant"].toString())["ok"].toBool());
      auto combo=RegionalVariants::storeCombination(score,"B组合");QVERIFY(combo["ok"].toBool());
      const int before=score->undoStack()->getCurIdx();
      const auto removed=RegionalVariants::remove(score,group,b["variant"].toString());
      QVERIFY2(removed["ok"].toBool(),qPrintable(removed["error"].toString()));
      QCOMPARE(score->undoStack()->getCurIdx(),before+1);QCOMPARE(note()->veloOffset(),0);
      auto g=RegionalVariants::state(score)["groups"].toList()[0].toMap();
      QCOMPARE(g["variants"].toList().size(),1);QCOMPARE(g["main"].toString(),original);
      QCOMPARE(RegionalVariants::state(score)["combinations"].toList()[0].toMap()["choices"].toMap()[group].toString(),original);
      EditData edit;score->undoRedo(true,&edit);QCOMPARE(note()->veloOffset(),35);
      QCOMPARE(RegionalVariants::state(score)["groups"].toList()[0].toMap()["variants"].toList().size(),2);
      score->undoRedo(false,&edit);QCOMPARE(note()->veloOffset(),0);
      const auto path=settings.filePath("regional-delete-070.mscz");QFileInfo info(path);
      QVERIFY2(score->saveCompressedFile(info,false,false),qPrintable(MScore::lastError));
      std::unique_ptr<MasterScore> restored(mscore->readScore(path));QVERIFY(restored);
      QCOMPARE(RegionalVariants::state(restored.get())["groups"].toList()[0].toMap()["variants"].toList().size(),1);
      QVERIFY(RegionalVariants::remove(score,group,original)["removedGroup"].toBool());
      QVERIFY(!RegionalVariants::active(score));QCOMPARE(note()->veloOffset(),0);
      QVERIFY(RegionalVariants::state(score)["combinations"].toList().isEmpty());
      score->undoRedo(true,&edit);QVERIFY(RegionalVariants::active(score));
      QVERIFY(RegionalVariants::removeCombination(score,combo["id"].toString())["ok"].toBool());
      QVERIFY(RegionalVariants::state(score)["combinations"].toList().isEmpty());
      score->undoRedo(true,&edit);QCOMPARE(RegionalVariants::state(score)["combinations"].toList().size(),1);
      // Deleting an inactive writing keeps the current unsaved notes.
      auto c=RegionalVariants::duplicate(score,group,"C");QVERIFY(c["ok"].toBool());
      score->startCmd();note()->undoChangeProperty(Pid::VELO_OFFSET,41);score->endCmd();
      QVERIFY(RegionalVariants::remove(score,group,c["variant"].toString())["ok"].toBool());QCOMPARE(note()->veloOffset(),41);
      // Removing a whole group also remains available after its structure changed.
      auto data=RegionalVariants::state(score);auto groups=data["groups"].toList();auto broken=groups[0].toMap();
      broken["signature"]="changed";groups[0]=broken;data["groups"]=groups;
      score->QObject::setProperty("kumoRegionalVariants",data);
      QVERIFY(RegionalVariants::remove(score,group)["ok"].toBool());QVERIFY(!RegionalVariants::active(score));QCOMPARE(note()->veloOffset(),41);
}
void TestP1Native::regionalDeleteMouseAndButtonPlacement() {
      auto score=mscore->readScore(QString(TESTROOT)+"/mtest/mscore/p0native/longroot.mscx");
      QVERIFY(score);mscore->setCurrentScoreView(mscore->appendScore(score));mscore->resize(1200,850);mscore->show();
      auto made=RegionalVariants::create(score,0,1920,{4},"左手伴奏");QVERIFY(made["ok"].toBool());
      const auto group=made["group"].toString();auto b=RegionalVariants::duplicate(score,group,"B",true);QVERIFY(b["ok"].toBool());
      auto view=mscore->currentScoreView();setRegionalControlsVisible(true);view->update();
      QToolButton *button=nullptr;QTRY_VERIFY(([&]{button=view->findChild<QToolButton*>("regionalScoreSwitch/"+group);return button&&button->isVisible();})());
      const auto original=button->pos();const auto point=button->rect().center();const QPoint target=button->mapToGlobal(point)+QPoint(100,70);
      const int before=score->undoStack()->getCurIdx();
      QTest::mousePress(button,Qt::LeftButton,Qt::NoModifier,point);
      QMouseEvent move(QEvent::MouseMove,button->mapFromGlobal(target),target,Qt::NoButton,Qt::LeftButton,Qt::NoModifier);QApplication::sendEvent(button,&move);
      QTest::mouseRelease(button,Qt::LeftButton,Qt::NoModifier,button->mapFromGlobal(target));
      const auto shifted=button->pos();QVERIFY((shifted-original).manhattanLength()>30);
      QCOMPARE(score->undoStack()->getCurIdx(),before+1);
      auto placement=RegionalVariants::state(score)["groups"].toList()[0].toMap()["controlOffset"].toMap();QVERIFY(!placement.isEmpty());
      EditData edit;score->undoRedo(true,&edit);view->update();QTRY_COMPARE(button->pos(),original);
      score->undoRedo(false,&edit);view->update();QTRY_COMPARE(button->pos(),shifted);
      const auto path=settings.filePath("regional-placement-070.mscz");QFileInfo info(path);QVERIFY(score->saveCompressedFile(info,false,false));
      std::unique_ptr<MasterScore> reopened(mscore->readScore(path));QVERIFY(reopened);
      QCOMPARE(RegionalVariants::state(reopened.get())["groups"].toList()[0].toMap()["controlOffset"].toMap(),placement);
      bool hidden=false;
      QTimer::singleShot(30,[&]{auto menu=button->menu();auto action=menu->findChild<QAction*>("regionalHideControl");if(action){hidden=true;QTest::mouseClick(menu,Qt::LeftButton,Qt::NoModifier,menu->actionGeometry(action).center());}else menu->hide();});
      QTest::mouseClick(button,Qt::LeftButton);QVERIFY(hidden);QTRY_VERIFY(!button->isVisible());
      QVERIFY(score->saveCompressedFile(info,false,false));
      std::unique_ptr<MasterScore> hiddenCopy(mscore->readScore(path));QVERIFY(hiddenCopy);
      QVERIFY(RegionalVariants::state(hiddenCopy.get())["groups"].toList()[0].toMap()["controlHidden"].toBool());
      score->undoRedo(true,&edit);view->update();QTRY_VERIFY(button->isVisible());
      showRegionalVariantPanel(group);auto dock=mscore->findChild<QDockWidget*>("kumoPanel/regionalVariantsDock");QVERIFY(dock);dock->setFloating(true);dock->resize(470,760);dock->show();
      auto toggle=dock->findChild<QCheckBox*>("regionalScoreButtonsToggle");QVERIFY(toggle);
      QTest::mouseClick(toggle,Qt::LeftButton,Qt::NoModifier,QPoint(10,toggle->height()/2));QTRY_VERIFY(!button->isVisible());
      QTest::mouseClick(toggle,Qt::LeftButton,Qt::NoModifier,QPoint(10,toggle->height()/2));QTRY_VERIFY(button->isVisible());
      auto remove=dock->findChild<QPushButton*>("regionalDelete");QVERIFY(remove&&remove->isEnabled());
      bool cancelled=false;QTimer::singleShot(30,[&]{for(auto w:QApplication::topLevelWidgets())if(auto dialog=qobject_cast<QMessageBox*>(w)){if(dialog->objectName()=="regionalDeleteDialog"){cancelled=true;dialog->reject();}}});
      QTest::mouseClick(remove,Qt::LeftButton);QVERIFY(cancelled);QCOMPARE(RegionalVariants::state(score)["groups"].toList()[0].toMap()["variants"].toList().size(),2);
      bool confirmed=false;QTimer::singleShot(30,[&]{for(auto w:QApplication::topLevelWidgets())if(auto dialog=qobject_cast<QMessageBox*>(w)){if(auto accept=dialog->findChild<QPushButton*>("regionalConfirmDelete")){confirmed=true;QTest::mouseClick(accept,Qt::LeftButton);}}});
      QTest::mouseClick(remove,Qt::LeftButton);QVERIFY(confirmed);
      QCOMPARE(RegionalVariants::state(score)["groups"].toList()[0].toMap()["variants"].toList().size(),1);
      score->undoRedo(true,&edit);QTest::qWait(550);
      auto tree=dock->findChild<QTreeWidget*>("regionalTree");QVERIFY(tree&&tree->currentItem());
      QCOMPARE(tree->currentItem()->data(0,Qt::UserRole).toString(),b["variant"].toString());
      QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->visualItemRect(tree->currentItem()).center());
      const auto output=qEnvironmentVariable("HARMONY_TEST_ARTIFACTS");if(!output.isEmpty()){
            dock->grab().save(output+"/regional-panel-070.png");
            auto box=view->toPhysical(score->firstMeasure()->system()->canvasBoundingRect()).united(button->geometry()).adjusted(-20,-40,20,30).intersected(view->rect());
            view->grab(box).save(output+"/regional-score-070.png");
      }
      dock->close();QVERIFY(!dock->isVisible());showRegionalVariantPanel(group);QVERIFY(dock->isVisible());
      QVERIFY(RegionalVariants::storeCombination(score,"面板删除组合")["ok"].toBool());QTest::qWait(550);
      auto removeCombo=dock->findChild<QPushButton*>("regionalDeleteCombination");QVERIFY(removeCombo&&removeCombo->isEnabled());
      auto savedCombo=dock->findChild<QComboBox*>("regionalCombinations");QVERIFY(savedCombo);
      savedCombo->setCurrentIndex(0);QVERIFY(!removeCombo->isEnabled());
      savedCombo->setCurrentIndex(1);QVERIFY(removeCombo->isEnabled());
      QTest::mouseClick(removeCombo,Qt::LeftButton);QVERIFY(RegionalVariants::state(score)["combinations"].toList().isEmpty());
      score->undoRedo(true,&edit);QTest::qWait(550);
      auto root=tree->topLevelItem(0);QVERIFY(root);
      QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->visualItemRect(root).center());
      auto preserved=toChord(score->findCR(Fraction::fromTicks(0),4))->downNote();
      QTimer::singleShot(30,[&]{for(auto w:QApplication::topLevelWidgets())if(auto dialog=qobject_cast<QMessageBox*>(w)){if(auto accept=dialog->findChild<QPushButton*>("regionalConfirmDelete"))QTest::mouseClick(accept,Qt::LeftButton);}});
      QTest::mouseClick(remove,Qt::LeftButton);QVERIFY(!RegionalVariants::active(score));
      QCOMPARE(toChord(score->findCR(Fraction::fromTicks(0),4))->downNote(),preserved);
      QTRY_COMPARE(tree->topLevelItemCount(),0);
      QTRY_VERIFY(!view->findChild<QToolButton*>("regionalScoreSwitch/"+group));
      score->undoRedo(true,&edit);QVERIFY(RegionalVariants::active(score));view->update();
      QTRY_VERIFY(view->findChild<QToolButton*>("regionalScoreSwitch/"+group));
      dock->hide();
}
void TestP1Native::regionalSingleClickActuallySwitches() {
      auto score = mscore->readScore(QString(TESTROOT)+"/mtest/mscore/p0native/longroot.mscx");
      QVERIFY(score); mscore->setCurrentScoreView(mscore->appendScore(score));
      auto made=RegionalVariants::create(score,0,score->firstMeasure()->endTick().ticks(),{4},"左手");
      auto copied=RegionalVariants::duplicate(score,made["group"].toString(),"B"); QVERIFY(copied["ok"].toBool());
      showRegionalVariantPanel(made["group"].toString());
      auto dock=mscore->findChild<QDockWidget*>("kumoPanel/regionalVariantsDock"); QVERIFY(dock);
      dock->setFloating(true);dock->resize(550,760);dock->show();QTest::qWait(50);
      auto tree=dock->findChild<QTreeWidget*>("regionalTree");QVERIFY(tree);
      auto item=tree->topLevelItem(0)->child(1);
      QTest::mouseClick(tree->viewport(),Qt::LeftButton,Qt::NoModifier,tree->visualItemRect(item).center());
      QCOMPARE(RegionalVariants::state(score)["groups"].toList()[0].toMap()["active"].toString(),copied["variant"].toString());
      dock->hide();
}
